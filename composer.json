{
  "name": "cloakwp/block-parser",
  "description": "Parse Gutenberg + ACF Blocks into structured objects.",
  "type": "library",
  "license": "LGPL-3.0-only",
  "autoload": {
    "psr-4": {
      "CloakWP\\BlockParser\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CloakWP\\BlockParser\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0",
    "roots/wordpress-no-content": "^6.7",
    "tburry/pquery": "^1.1"
  },
  "scripts": {
    "test": "phpunit",
    "test:pquery": "BLOCK_PARSER_HTML_ADAPTER=pquery phpunit"
  },
  "require": {
    "php": ">=8.4",
    "cloakwp/hook-modifiers": "dev-main",
    "composer/installers": "^2.2",
    "franzl/studio": "*",
    "ext-dom": "*"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "franzl/studio": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "tburry/pquery": "Optional legacy HTML adapter for compatibility checks and benchmarks."
  }
}
